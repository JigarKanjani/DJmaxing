    "butterchurn-presets": "2.4.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "signalsmith-stretch": "1.3.2",
    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/youtube": "0.1.2",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
