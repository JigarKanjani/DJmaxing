# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.

# Spotify playlist export (optional). This is a public client ID, safe in the browser (PKCE, no secret).
# Create an app at https://developer.spotify.com/dashboard and add your redirect URIs:
#   http://127.0.0.1:5173/        (local dev)
#   https://YOUR-APP.vercel.app/  (production)
VITE_SPOTIFY_CLIENT_ID=

# YouTube search inside the curator (optional). SERVER-SIDE ONLY: read by api/youtube-search.ts on Vercel.
# Never prefix it with VITE_, or it would be bundled into the public site.
YOUTUBE_API_KEY=
